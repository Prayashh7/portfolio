# Copy to .env and fill in real values. Never commit .env.

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database ---------------------------------------------------------------
# Full connection string. Managed providers (Render, Neon, Supabase) hand you one.
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/prayash_portfolio
# Set to true when the provider requires TLS (most hosted Postgres does).
DATABASE_SSL=false
# Last resort. Leave this false: it keeps the connection encrypted but stops
# checking the server's certificate, which means an attacker in the middle can
# impersonate the database. Only set it if your provider uses a self-signed
# certificate and connections fail with SELF_SIGNED_CERT_IN_CHAIN.
DATABASE_SSL_NO_VERIFY=false

# --- Sessions ---------------------------------------------------------------
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out. The server refuses to start if it is missing
# or shorter than 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- The admin account created by `npm run seed` ----------------------------
# Only read during seeding, and only used when no admin exists yet.
# Use a password you do not use anywhere else.
ADMIN_EMAIL=prayashb824@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Prayash Bartaula

# --- CORS -------------------------------------------------------------------
# Comma-separated list of origins allowed to send credentialed requests.
# Anything not on this list is refused. No wildcards.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Session cookie scope ---------------------------------------------------
# lax  - the site and the API share a domain (prayashbartaula.com.np and
#        api.prayashbartaula.com.np), or you are running both on localhost.
# none - the site and the API are on different domains, e.g. the frontend on
#        Netlify and the API on Render. Required there, otherwise the browser
#        discards the session cookie and signing in silently fails.
#        Needs HTTPS, so it only works with NODE_ENV=production.
COOKIE_SAMESITE=lax

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=6

# --- Contact form email (optional) ------------------------------------------
# Leave SMTP_HOST empty and messages are still stored in the database and shown
# in the dashboard — the form works without email configured. Fill these in to
# also get a notification in your inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portfolio <no-reply@prayashbartaula.com.np>"
CONTACT_NOTIFY_TO=prayashb824@gmail.com
