backend/public/media/uploads/

# Logs
logs/
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test and coverage
coverage/
.nyc_output/

# Local scratch
tmp/
*.local
